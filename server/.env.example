# Set these in the server process environment (this file is a reference, not auto-loaded).
PORT=3001
# Optional IP address to bind; omitted means all interfaces. Use loopback behind local Nginx.
# HOST=127.0.0.1
# Trust forwarded client addresses only from a local reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_LOOPBACK=false
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional absolute path; defaults to server/data/database.json.
# DATABASE_PATH=D:/card-together-data/database.json
# NODE_ENV=production enables Secure session cookies; production requires HTTPS and CLIENT_ORIGIN.
