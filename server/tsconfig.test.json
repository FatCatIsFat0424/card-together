{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/server-tests.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "vite/client"],
    "allowImportingTsExtensions": true,
    "declaration": false,
    "sourceMap": false,
    "paths": {
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "benchmarks/**/*.ts", "../shared/src/**/*.ts", "../scripts/**/*.ts", "vitest.config.ts"]
}
