[Unit]
Description=Card Together server
After=network.target
Conflicts=bridge-online.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=card-together
Group=card-together
WorkingDirectory=/opt/card-together/server
EnvironmentFile=/etc/card-together/server.env
ExecStart=/opt/card-together/node --import tsx src/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
StateDirectory=card-together
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=card-together

[Install]
WantedBy=multi-user.target
