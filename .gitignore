# Dependencies
node_modules/

# Build output and tool caches
dist
*.tsbuildinfo
.eslintcache
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
coverage

# Logs
logs
*.log
npm-debug.log*

# Environment files (secrets); the example stays tracked
.env
.env.*
!.env.example

# Persistent application database and atomic-write files
server/data/

# Local deployment runtime prepared by deploy/build.sh
.deploy/

# Temporary implementation plans
.plan/

# Owner music originals and generated playback assets
/local-music/
/client/public/provided-music/imported-*
/client/public/provided-music/.import-*/
/client/src/audio/provided-music.generated.json
/client/src/audio/provided-music.generated.json.*.tmp

# Site emoji originals and generated chat assets
/local-emoji/
/client/public/provided-emoji/*.png
/client/public/provided-emoji/*.jpg
/client/public/provided-emoji/*.gif
/client/public/provided-emoji/*.webp
/client/public/provided-emoji/.import-*/
/shared/src/provided-emoji.generated.json
/shared/src/provided-emoji.generated.json.*.tmp
