# Vite loads client/.env.local when starting the dev server or building.
# Public application path; defaults to /. Must start and end with /.
# VITE_BASE_PATH=/card-together/

# Optional API / Socket server; empty uses the same origin and application base path.
# VITE_SERVER_URL=https://api.example.com
# External servers default to /socket.io; override for a proxy mounted below a subpath.
# VITE_SOCKET_PATH=/card-together/socket.io

# Optional JSON array of browser-visible WebRTC ICE servers.
# Default: Google's public STUN server. Restrictive networks need an operated TURN server.
# Use credentials intended for browser clients, with appropriate expiry / usage limits.
# Never place private application secrets in VITE_ variables: they enter the client bundle.
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"replace-me","credential":"replace-me"}]
