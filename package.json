{
  "name": "card-together",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer card games to play together",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "cd server && npx tsx watch src/index.ts",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "test": "cd server && npx vitest run",
    "test:watch": "cd server && npx vitest",
    "bench:database": "cd server && npx tsx tests/database/repository-benchmark.ts",
    "bench:socket": "cd server && npx tsx benchmarks/socket-benchmark.ts",
    "lint": "eslint \"shared/src/**/*.ts\" \"server/src/**/*.ts\" \"client/src/**/*.{ts,tsx}\"",
    "typecheck": "npm run typecheck:shared && npm run typecheck:server && npm run typecheck:client",
    "typecheck:shared": "cd shared && npx tsc --noEmit",
    "typecheck:server": "cd server && npx tsc --noEmit",
    "typecheck:client": "cd client && npx tsc -p tsconfig.app.json --noEmit && npx tsc -p tsconfig.node.json --noEmit",
    "music:import": "node scripts/audio/import-provided-music.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.71.0"
  }
}
